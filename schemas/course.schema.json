{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cert-learner.local/schemas/course.schema.json",
  "title": "Cert Learner course manifest",
  "type": "object",
  "required": ["format", "schemaVersion", "contentVersion", "courseId", "title", "units"],
  "additionalProperties": true,
  "properties": {
    "format": { "const": "cert-learner" },
    "schemaVersion": { "const": 1 },
    "contentVersion": { "$ref": "#/definitions/id" },
    "courseId": { "$ref": "#/definitions/id" },
    "title": { "$ref": "#/definitions/title" },
    "overview": { "$ref": "#/definitions/markdown" },
    "studyGuideUrl": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "studyGuideVersion": { "$ref": "#/definitions/title" },
    "language": { "type": "string", "minLength": 1, "maxLength": 128 },
    "references": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "required": ["title", "url"],
        "properties": {
          "title": { "$ref": "#/definitions/title" },
          "url": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    },
    "resources": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "required": ["title", "path"],
        "properties": {
          "title": { "$ref": "#/definitions/title" },
          "path": { "$ref": "#/definitions/markdown" }
        }
      }
    },
    "units": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["unitId", "displayNumber", "title", "resources", "activities"],
        "properties": {
          "unitId": { "$ref": "#/definitions/id" },
          "displayNumber": { "$ref": "#/definitions/title" },
          "title": { "$ref": "#/definitions/title" },
          "domain": { "type": ["string", "null"], "maxLength": 1024 },
          "resources": {
            "type": "object", "required": ["lesson"],
            "properties": {
              "lesson": { "$ref": "#/definitions/markdown" },
              "lab": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\.[iI][pP][yY][nN][bB]$" },
              "quiz": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\.(?:[mM][dD]|[jJ][sS][oO][nN])$" }
            }
          },
          "activities": {
            "type": "array", "minItems": 1, "maxItems": 1000,
            "items": {
              "type": "object", "required": ["activityId", "title", "objectives"],
              "properties": {
                "activityId": { "$ref": "#/definitions/id" },
                "title": { "$ref": "#/definitions/title" },
                "objectives": {
                  "type": "array", "maxItems": 100,
                  "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
                },
                "completion": { "enum": ["manual", "check"], "default": "manual" },
                "check": { "$ref": "#/definitions/check" }
              },
              "allOf": [{
                "if": { "properties": { "completion": { "const": "check" } }, "required": ["completion"] },
                "then": { "required": ["check"] }
              }]
            }
          }
        }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "markdown": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\.[mM][dD]$" },
    "check": {
      "type": "object", "required": ["runtime", "file"], "additionalProperties": false,
      "properties": {
        "runtime": { "enum": ["node", "python", "pwsh"] },
        "file": { "$ref": "#/definitions/path" },
        "cwd": { "$ref": "#/definitions/path" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    }
  }
}
{
  "name": "cert-learner",
  "displayName": "Certification Learning",
  "description": "Learn across certification courses with guided lessons, native notebooks, and private local progress.",
  "version": "0.1.1",
  "publisher": "tjav",
  "license": "UNLICENSED",
  "repository": { "type": "git", "url": "https://github.com/tjav/cert-learner.git" },
  "extensionKind": ["workspace"],
  "capabilities": { "untrustedWorkspaces": { "supported": "limited", "description": "Reading and tracking work; checks, output edits and tutor context sharing require trust." }, "virtualWorkspaces": false },
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["workspaceContains:course.json", "onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": { "activitybar": [{ "id": "certLearner", "title": "Learning", "icon": "media/learning.svg" }] },
    "views": { "certLearner": [{ "id": "certLearner.courses", "name": "Certification Courses" }] },
    "viewsWelcome": [{ "view": "certLearner.courses", "contents": "Add a local certification course to begin. No code runs automatically.\n[Add Course](command:certLearner.add)\n[Try Sample Course](command:certLearner.sample)" }],
    "commands": [
      { "command": "certLearner.add", "title": "Learning: Add Course", "icon": "$(add)" },
      { "command": "certLearner.refresh", "title": "Learning: Refresh Courses", "icon": "$(refresh)" },
      { "command": "certLearner.resume", "title": "Learning: Resume Course", "icon": "$(play)" },
      { "command": "certLearner.open", "title": "Learning: Open Activity" },
      { "command": "certLearner.openPage", "title": "Learning: Open Course Page" },
      { "command": "certLearner.portalWalkthrough", "title": "Learning: Portal Walkthrough", "icon": "$(browser)" },
      { "command": "certLearner.revertUnit", "title": "Learning: Revert Unit", "icon": "$(discard)" },
      { "command": "certLearner.sample", "title": "Learning: Try Sample Course" },
      { "command": "certLearner.export", "title": "Learning: Export Progress" },
      { "command": "certLearner.import", "title": "Learning: Import Progress" },
      { "command": "certLearner.reset", "title": "Learning: Reset Course Progress" },
      { "command": "certLearner.remove", "title": "Learning: Remove Course from List" },
      { "command": "certLearner.getState", "title": "Learning: Get Current State" }
    ],
    "menus": {
      "view/title": [
        { "command": "certLearner.add", "when": "view == certLearner.courses", "group": "navigation" },
        { "command": "certLearner.refresh", "when": "view == certLearner.courses", "group": "navigation" },
        { "command": "certLearner.resume", "when": "view == certLearner.courses", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "certLearner.portalWalkthrough", "when": "view == certLearner.courses && viewItem == certLearner.activity && isWorkspaceTrusted", "group": "learningTools" },
        { "command": "certLearner.revertUnit", "when": "view == certLearner.courses && viewItem == certLearner.activity && isWorkspaceTrusted", "group": "learningTools" }
      ],
      "commandPalette": [{ "command": "certLearner.open", "when": "false" }, { "command": "certLearner.openPage", "when": "false" }, { "command": "certLearner.getState", "when": "false" }]
    },
    "configuration": { "title": "Certification Learning", "properties": {
      "certLearner.runtimes.node": { "type": "string", "default": "node", "scope": "machine", "restricted": true, "description": "Node executable for explicitly approved course checks." },
      "certLearner.runtimes.python": { "type": "string", "default": "python", "scope": "machine", "restricted": true, "description": "Python executable for approved checks; select the intended environment explicitly." },
      "certLearner.runtimes.pwsh": { "type": "string", "default": "pwsh", "scope": "machine", "restricted": true, "description": "PowerShell executable for explicitly approved checks." }
    } },
    "jsonValidation": [{ "fileMatch": "course.json", "url": "./schemas/course.schema.json" }],
    "chatParticipants": [{ "id": "certLearner.tutor", "name": "certlearning", "fullName": "Certification Learning", "description": "Explain the selected learning activity with course references", "commands": [{ "name": "explain", "description": "Explain the current concept" }, { "name": "hint", "description": "Give a small hint without revealing solutions" }] }]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "mocha out/src/test/core.test.js out/src/test/render.test.js out/src/test/runner.test.js out/src/test/pages.test.js out/src/test/activityTools.test.js out/src/test/uiActions.test.js",
    "test:integration": "npm run compile-tests && vscode-test",
    "vsix": "vsce package --no-dependencies --allow-missing-repository --skip-license",
    "validate-course": "node out/src/validateCourse.js"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/sanitize-html": "^2.16.1",
    "@types/vscode": "^1.103.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "mocha": "^12.0.0-rc.6",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "markdown-it": "^15.0.1",
    "sanitize-html": "^2.17.7"
  }
}
